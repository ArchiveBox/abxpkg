    <style>
      body {
        font-family: var(--ab-font-sans);
      }

      .hero {
        padding: var(--ab-s-8) 0 var(--ab-s-7);
        border-bottom: 1px solid var(--ab-rule-strong);
      }

      .hero__masthead {
        display: block;
      }

      .hero__title {
        font-size: clamp(54px, 8vw, 96px);
        line-height: 0.92;
        letter-spacing: -0.04em;
        font-weight: 400;
        margin: 0;
      }

      .hero__wordmark {
        display: inline-block;
        font-family: var(--ab-font-mono);
        font-size: 0.9em;
        line-height: 1;
        color: var(--ab-fg);
      }

      .hero__copy {
        margin-top: var(--ab-s-4);
        max-width: 60ch;
        font-family: var(--ab-font-serif);
        font-size: var(--ab-size-lg);
      }

      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ab-s-3);
        margin-top: var(--ab-s-5);
      }

      .hero__support {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: var(--ab-s-4);
      }

      .hero__support code {
        font-size: 11px;
        padding: 4px 8px;
        background: var(--ab-bg-sunken);
        border: 1px solid var(--ab-rule);
        border-radius: var(--ab-r-1);
      }

      .hero__stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 240px));
        gap: var(--ab-s-3);
        margin-top: var(--ab-s-6);
      }

      .stat {
        border: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-elev);
        padding: var(--ab-s-4);
        min-height: 104px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .stat strong {
        display: block;
        font-family: var(--ab-font-serif);
        font-size: clamp(30px, 3vw, 44px);
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--ab-fg);
      }

      .stat span {
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ab-fg-muted);
      }

      .hero-example {
        margin-top: var(--ab-s-7);
        border: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-elev);
      }

      .hero-example-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: var(--ab-s-4);
        padding: var(--ab-s-4) var(--ab-s-5);
        border-bottom: 1px solid var(--ab-rule);
        background: var(--ab-bg-sunken);
      }

      .hero-example-title {
        margin: 0;
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ab-accent);
      }

      .hero-example-copy {
        margin: 6px 0 0;
        max-width: 54ch;
      }

      .hero-runner-links {
        display: flex;
        align-items: center;
        gap: var(--ab-s-2);
        flex-wrap: wrap;
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-xs);
        color: var(--ab-fg-muted);
      }

      .runner-link {
        text-decoration: none;
      }

      .hero-code-block {
        padding: var(--ab-s-4) var(--ab-s-5) var(--ab-s-5);
      }

      .hero-code-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--ab-s-3);
        margin-bottom: var(--ab-s-3);
      }

      .hero-code-meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ab-s-2);
        align-items: center;
      }

      .hero-code-kicker {
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ab-fg-muted);
      }

      .copy-button,
      .run-tab {
        appearance: none;
        border: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-elev);
        color: var(--ab-fg);
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 8px 12px;
        cursor: pointer;
      }

      .copy-button:hover,
      .run-tab:hover {
        background: var(--ab-bg-sunken);
      }

      .hero-code-block .ab-terminal {
        box-shadow: none;
      }

      .hero-code-block .ab-terminal__body pre {
        font-size: var(--ab-size-sm);
        line-height: 1.7;
      }

      .install-details {
        padding: 0 var(--ab-s-5) var(--ab-s-5);
      }

      .install-details summary {
        cursor: pointer;
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ab-fg-muted);
      }

      .install-details pre {
        margin-top: var(--ab-s-3);
      }

      .install-details .ab-terminal {
        margin-top: var(--ab-s-3);
        box-shadow: none;
      }

      .catalog-toolbar {
        padding: var(--ab-s-5) 0;
        border-bottom: 1px solid var(--ab-rule);
        position: sticky;
        top: 57px;
        z-index: 10;
        background: color-mix(in srgb, var(--ab-bg) 92%, transparent);
        backdrop-filter: blur(10px);
      }

      .catalog-toolbar .ab-container,
      .catalog .ab-container {
        max-width: none;
      }

      .catalog-toolbar__grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: var(--ab-s-3);
        align-items: end;
      }

      .searchbox {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .searchbox__control {
        position: relative;
      }

      .searchbox__control input {
        padding-left: 38px;
        font-family: var(--ab-font-mono);
      }

      .searchbox__control svg {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--ab-fg-faint);
      }

      .result-count {
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-xs);
        color: var(--ab-fg-muted);
        white-space: nowrap;
        padding-bottom: 8px;
      }

      .catalog {
        padding: var(--ab-s-7) 0;
      }

      .category-section + .category-section {
        margin-top: var(--ab-s-7);
      }

      .category-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: var(--ab-s-4);
        margin-bottom: var(--ab-s-4);
        padding-bottom: var(--ab-s-3);
        border-bottom: 1px solid var(--ab-rule);
      }

      .category-header h2 {
        margin: 0;
      }

      .category-header span {
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-xs);
        color: var(--ab-fg-muted);
      }

      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: var(--ab-s-4);
      }

      .plugin-card {
        border: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-elev);
        box-shadow: var(--ab-shadow-1);
      }

      .plugin-card summary {
        list-style: none;
        cursor: pointer;
      }

      .plugin-card summary::-webkit-details-marker {
        display: none;
      }

      .plugin-card summary:hover .plugin-card__frame,
      .plugin-card.modal-active .plugin-card__frame {
        border-color: var(--ab-accent);
        box-shadow: var(--ab-shadow-2);
      }

      .plugin-card__frame {
        display: block;
        padding: var(--ab-s-5);
        border: 1px solid transparent;
        transition: border-color var(--ab-dur-2) var(--ab-ease), box-shadow var(--ab-dur-2) var(--ab-ease);
      }

      .plugin-main h2 {
        margin: 0;
        font-size: var(--ab-size-xl);
      }

      .plugin-title-row {
        display: flex;
        align-items: baseline;
        gap: var(--ab-s-3);
        flex-wrap: wrap;
      }

      .provider-hero-emoji {
        margin-right: var(--ab-s-2);
      }

      .plugin-slug {
        margin-top: 6px;
        color: var(--ab-fg-muted);
      }

      .plugin-summary-description {
        margin: var(--ab-s-3) 0 0;
      }

      .plugin-subline,
      .provider-meta-grid,
      .hook-card-chips,
      .pill-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .plugin-subline {
        margin-top: var(--ab-s-4);
      }

      .plugin-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-sunken);
        color: var(--ab-accent);
        padding: 10px;
        font-size: 40px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 22px;
        padding: 3px 9px;
        border: 1px solid var(--ab-rule);
        background: var(--ab-bg-sunken);
        font-family: var(--ab-font-mono);
        font-size: 10px;
        color: var(--ab-ink-2);
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .plugin-body {
        padding: var(--ab-s-5);
      }

      .plugin-body > * + * {
        margin-top: var(--ab-s-5);
      }

      .plugin-modal-description {
        margin: 0;
        font-size: var(--ab-size-md);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ab-s-3);
      }

      .provider-meta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--ab-s-3);
      }

      .provider-meta-grid article,
      .global-env-wrap,
      .footer-card {
        border: 1px solid var(--ab-rule);
        background: var(--ab-bg-sunken);
        padding: var(--ab-s-4);
      }

      .provider-meta-grid span,
      .footer-card-subtitle {
        display: block;
        margin-bottom: 6px;
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ab-fg-muted);
      }

      .provider-meta-grid code {
        word-break: break-word;
      }

      .section-title {
        margin: 0;
        padding-top: var(--ab-s-3);
        border-top: 1px solid var(--ab-rule);
      }

      .run-tabs {
        border: 1px solid var(--ab-rule-strong);
      }

      .run-tabs-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        border-bottom: 1px solid var(--ab-rule);
        background: var(--ab-bg-sunken);
      }

      .run-tab {
        border-width: 0 1px 0 0;
        background: transparent;
      }

      .run-tab.active {
        background: var(--ab-bg-elev);
        color: var(--ab-accent);
      }

      .run-tab-panel {
        display: none;
        border: 0;
        margin: 0;
        padding: var(--ab-s-4);
        background: #17130f;
        color: #ece4d0;
        overflow-x: auto;
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-sm);
        line-height: 1.7;
      }

      .run-tab-panel.active {
        display: block;
      }

      .config-table-wrap {
        overflow-x: auto;
        border: 1px solid var(--ab-rule);
      }

      .env-table {
        table-layout: fixed;
      }

      .env-table .col-env-key {
        width: 24%;
      }

      .env-table .col-env-default {
        width: 32%;
      }

      .env-table .col-env-desc {
        width: 44%;
      }

      .env-table td:nth-child(2) code,
      .env-table td:nth-child(2) .cfg-default,
      .env-table td:nth-child(3) small {
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .config-key-desc {
        display: block;
        margin-top: 6px;
        font-size: var(--ab-size-sm);
        color: var(--ab-fg-muted);
      }

      .cfg-default {
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-xs);
      }

      .empty-state {
        padding: var(--ab-s-6);
        text-align: center;
        border: 1px dashed var(--ab-rule-strong);
        color: var(--ab-fg-muted);
        background: var(--ab-bg-elev);
      }

      .global-env {
        padding: 0 0 var(--ab-s-7);
      }

      .global-env-wrap {
        background: var(--ab-bg-elev);
      }

      .global-env-wrap h2 {
        margin-top: 0;
      }

      .page-footer {
        padding: var(--ab-s-8) 0 var(--ab-s-7);
        border-top: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-sunken);
      }

      .footer-intro {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        gap: var(--ab-s-6);
        align-items: start;
        margin-bottom: var(--ab-s-6);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--ab-s-4);
      }

      .footer-card {
        background: var(--ab-bg-elev);
      }

      .footer-link-list {
        display: grid;
        gap: var(--ab-s-2);
      }

      .footer-link-item {
        display: grid;
        grid-template-columns: 28px minmax(0, 1fr);
        gap: var(--ab-s-3);
        padding: var(--ab-s-3) 0;
        border-top: 1px dashed var(--ab-rule);
        text-decoration: none;
      }

      .footer-link-item:first-child {
        border-top: 0;
        padding-top: 0;
      }

      .footer-link-copy strong {
        display: block;
        color: var(--ab-fg);
      }

      .footer-link-copy span {
        display: block;
        margin-top: 4px;
        color: var(--ab-fg-muted);
        font-size: var(--ab-size-sm);
      }

      .footer-meta {
        display: flex;
        justify-content: space-between;
        gap: var(--ab-s-3);
        flex-wrap: wrap;
        margin-top: var(--ab-s-6);
        padding-top: var(--ab-s-4);
        border-top: 1px solid var(--ab-rule);
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-xs);
        color: var(--ab-fg-muted);
      }

      .plugin-modal {
        width: min(1040px, calc(100vw - 40px));
        max-height: calc(100vh - 40px);
        padding: 0;
        border: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg);
        color: var(--ab-fg);
        box-shadow: var(--ab-shadow-2);
      }

      .plugin-modal::backdrop {
        background: rgba(28, 24, 20, 0.45);
        backdrop-filter: blur(3px);
      }

      .plugin-modal-header {
        display: flex;
        justify-content: space-between;
        gap: var(--ab-s-4);
        align-items: center;
        padding: var(--ab-s-4) var(--ab-s-5);
        border-bottom: 1px solid var(--ab-rule);
        background: var(--ab-bg-elev);
        position: sticky;
        top: 0;
        z-index: 1;
      }

      .plugin-modal-header-left {
        display: flex;
        align-items: center;
        gap: 0;
        min-width: 0;
      }

      .plugin-modal-header-left h2 {
        margin: 0;
      }

      .plugin-modal-close {
        appearance: none;
        border: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg);
        width: 34px;
        height: 34px;
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
      }

      .plugin-modal-close:hover {
        background: var(--ab-bg-sunken);
      }

      .plugin-modal .plugin-body {
        max-height: calc(100vh - 120px);
        overflow-y: auto;
      }

      .ab-terminal code,
      .run-tab-panel code {
        background: none;
        border: 0;
        padding: 0;
        color: inherit;
      }

      .code-comment {
        color: #8f8675;
      }

      .code-command {
        color: #f0e4cd;
      }

      .code-option {
        color: #d6a654;
      }

      .code-string {
        color: #c26a6a;
      }

      .code-env {
        color: #8aa062;
      }

      .code-boolean {
        color: #d6a654;
      }

      .code-value {
        color: #c8bea8;
      }

      @media (max-width: 1100px) {
        .footer-intro,
        .provider-meta-grid,
        .footer-grid {
          grid-template-columns: 1fr;
        }

        .gallery {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 820px) {
        .ab-topbar {
          flex-wrap: wrap;
          justify-content: center;
        }

        .ab-topbar__nav {
          margin-left: 0;
          width: 100%;
          justify-content: center;
          flex-wrap: wrap;
        }

        .hero__stats {
          grid-template-columns: 1fr;
        }

        .catalog-toolbar {
          position: static;
        }

        .catalog-toolbar__grid,
        .hero-example-header,
        .hero-code-toolbar,
        .plugin-card__frame {
          grid-template-columns: 1fr;
          flex-direction: column;
          align-items: flex-start;
        }
      }

      @media (max-width: 640px) {
        .ab-container {
          padding: 0 var(--ab-s-4);
        }

        .hero__title {
          font-size: clamp(42px, 14vw, 72px);
        }

        .hero__copy {
          font-size: var(--ab-size-md);
        }

        .plugin-body,
        .plugin-card__frame,
        .footer-card,
        .plugin-modal-header,
        .hero-code-block,
        .hero-example-header,
        .global-env-wrap {
          padding-left: var(--ab-s-4);
          padding-right: var(--ab-s-4);
        }

        .plugin-modal {
          width: calc(100vw - 20px);
          max-height: calc(100vh - 20px);
        }
      }
    </style>
